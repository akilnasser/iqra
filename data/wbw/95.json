{"1":[["وَٱلتِّينِ","By the fig"],["وَٱلزَّيْتُونِ","and the olive"]],"2":[["وَطُورِ","And (the) Mount"],["سِينِينَ","Sinai"]],"3":[["وَهَـٰذَا","And this"],["ٱلْبَلَدِ","[the] city"],["ٱلْأَمِينِ","[the] secure"]],"4":[["لَقَدْ","Indeed"],["خَلَقْنَا","We created"],["ٱلْإِنسَـٰنَ","man"],["فِىٓ","in"],["أَحْسَنِ","(the) best"],["تَقْوِيمٍۢ","mould"]],"5":[["ثُمَّ","Then"],["رَدَدْنَـٰهُ","We returned him"],["أَسْفَلَ","(to the) lowest"],["سَـٰفِلِينَ","(of the) low"]],"6":[["إِلَّا","Except"],["ٱلَّذِينَ","those who"],["ءَامَنُوا۟","believe"],["وَعَمِلُوا۟","and do"],["ٱلصَّـٰلِحَـٰتِ","righteous deeds"],["فَلَهُمْ","then for them"],["أَجْرٌ","(is a) reward"],["غَيْرُ","never"],["مَمْنُونٍۢ","ending"]],"7":[["فَمَا","Then what"],["يُكَذِّبُكَ","causes you to deny"],["بَعْدُ","after (this)"],["بِٱلدِّينِ","the judgment"]],"8":[["أَلَيْسَ","Is not"],["ٱللَّهُ","Allah"],["بِأَحْكَمِ","(the) Most Just"],["ٱلْحَـٰكِمِينَ","(of) the Judges"]]}