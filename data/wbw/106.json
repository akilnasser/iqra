{"1":[["لِإِيلَـٰفِ","For (the) familiarity"],["قُرَيْشٍ","(of the) Quraish"]],"2":[["إِۦلَـٰفِهِمْ","Their familiarity"],["رِحْلَةَ","(with the) journey"],["ٱلشِّتَآءِ","(of) winter"],["وَٱلصَّيْفِ","and summer"]],"3":[["فَلْيَعْبُدُوا۟","So let them worship"],["رَبَّ","(the) Lord"],["هَـٰذَا","(of) this"],["ٱلْبَيْتِ","House"]],"4":[["ٱلَّذِىٓ","The One Who"],["أَطْعَمَهُم","feeds them"],["مِّن","[from]"],["جُوعٍۢ","(against) hunger"],["وَءَامَنَهُم","and gives them security"],["مِّنْ","from"],["خَوْفٍۭ","fear"]]}