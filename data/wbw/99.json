{"1":[["إِذَا","When"],["زُلْزِلَتِ","is shaken"],["ٱلْأَرْضُ","the earth"],["زِلْزَالَهَا","(with) its earthquake"]],"2":[["وَأَخْرَجَتِ","And brings forth"],["ٱلْأَرْضُ","the earth"],["أَثْقَالَهَا","its burdens"]],"3":[["وَقَالَ","And says"],["ٱلْإِنسَـٰنُ","man"],["مَا","What"],["لَهَا","(is) with it"]],"4":[["يَوْمَئِذٍۢ","That Day"],["تُحَدِّثُ","it will report"],["أَخْبَارَهَا","its news"]],"5":[["بِأَنَّ","Because"],["رَبَّكَ","your Lord"],["أَوْحَىٰ","inspired"],["لَهَا","[to] it"]],"6":[["يَوْمَئِذٍۢ","That Day"],["يَصْدُرُ","will proceed"],["ٱلنَّاسُ","the mankind"],["أَشْتَاتًۭا","(in) scattered groups"],["لِّيُرَوْا۟","to be shown"],["أَعْمَـٰلَهُمْ","their deeds"]],"7":[["فَمَن","So whoever"],["يَعْمَلْ","does"],["مِثْقَالَ","(equal to the) weight"],["ذَرَّةٍ","(of) an atom"],["خَيْرًۭا","good"],["يَرَهُۥ","will see it"]],"8":[["وَمَن","And whoever"],["يَعْمَلْ","does"],["مِثْقَالَ","(equal to the) weight"],["ذَرَّةٍۢ","(of) an atom"],["شَرًّۭا","evil"],["يَرَهُۥ","will see it"]]}