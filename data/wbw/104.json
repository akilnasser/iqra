{"1":[["وَيْلٌۭ","Woe"],["لِّكُلِّ","to every"],["هُمَزَةٍۢ","slanderer"],["لُّمَزَةٍ","backbiter"]],"2":[["ٱلَّذِى","The one who"],["جَمَعَ","collects"],["مَالًۭا","wealth"],["وَعَدَّدَهُۥ","and counts it"]],"3":[["يَحْسَبُ","Thinking"],["أَنَّ","that"],["مَالَهُۥٓ","his wealth"],["أَخْلَدَهُۥ","will make him immortal"]],"4":[["كَلَّا ۖ","Nay"],["لَيُنۢبَذَنَّ","Surely he will be thrown"],["فِى","in"],["ٱلْحُطَمَةِ","the Crusher"]],"5":[["وَمَآ","And what"],["أَدْرَىٰكَ","will make you know"],["مَا","what"],["ٱلْحُطَمَةُ","the Crusher (is)"]],"6":[["نَارُ","A Fire"],["ٱللَّهِ","Allah"],["ٱلْمُوقَدَةُ","kindled"]],"7":[["ٱلَّتِى","Which"],["تَطَّلِعُ","mounts up"],["عَلَى","to"],["ٱلْأَفْـِٔدَةِ","the hearts"]],"8":[["إِنَّهَا","Indeed, it"],["عَلَيْهِم","(will be) upon them"],["مُّؤْصَدَةٌۭ","closed over"]],"9":[["فِى","In"],["عَمَدٍۢ","columns"],["مُّمَدَّدَةٍۭ","extended"]]}