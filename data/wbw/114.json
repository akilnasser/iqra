{"1":[["قُلْ","Say"],["أَعُوذُ","I seek refuge"],["بِرَبِّ","in (the) Lord"],["ٱلنَّاسِ","(of) mankind"]],"2":[["مَلِكِ","(The) King"],["ٱلنَّاسِ","(of) mankind"]],"3":[["إِلَـٰهِ","(The) God"],["ٱلنَّاسِ","(of) mankind"]],"4":[["مِن","From"],["شَرِّ","(the) evil"],["ٱلْوَسْوَاسِ","(of) the whisperer"],["ٱلْخَنَّاسِ","the one who withdraws"]],"5":[["ٱلَّذِى","The one who"],["يُوَسْوِسُ","whispers"],["فِى","in"],["صُدُورِ","(the) breasts"],["ٱلنَّاسِ","(of) mankind"]],"6":[["مِنَ","From"],["ٱلْجِنَّةِ","the jinn"],["وَٱلنَّاسِ","and men"]]}