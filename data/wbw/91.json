{"1":[["وَٱلشَّمْسِ","By the sun"],["وَضُحَىٰهَا","and its brightness"]],"2":[["وَٱلْقَمَرِ","And the moon"],["إِذَا","when"],["تَلَىٰهَا","it follows it"]],"3":[["وَٱلنَّهَارِ","And the day"],["إِذَا","when"],["جَلَّىٰهَا","it displays it"]],"4":[["وَٱلَّيْلِ","And the night"],["إِذَا","when"],["يَغْشَىٰهَا","it covers it"]],"5":[["وَٱلسَّمَآءِ","And the heaven"],["وَمَا","and (He) Who"],["بَنَىٰهَا","constructed it"]],"6":[["وَٱلْأَرْضِ","And the earth"],["وَمَا","and by (He) Who"],["طَحَىٰهَا","spread it"]],"7":[["وَنَفْسٍۢ","And (the) soul"],["وَمَا","and (He) Who"],["سَوَّىٰهَا","proportioned it"]],"8":[["فَأَلْهَمَهَا","And He inspired it"],["فُجُورَهَا","(to distinguish) its wickedness"],["وَتَقْوَىٰهَا","and its righteousness"]],"9":[["قَدْ","Indeed"],["أَفْلَحَ","he succeeds"],["مَن","who"],["زَكَّىٰهَا","purifies it"]],"10":[["وَقَدْ","And indeed"],["خَابَ","he fails"],["مَن","who"],["دَسَّىٰهَا","buries it"]],"11":[["كَذَّبَتْ","Denied"],["ثَمُودُ","Thamud"],["بِطَغْوَىٰهَآ","by their transgression"]],"12":[["إِذِ","When"],["ٱنۢبَعَثَ","(was) sent forth"],["أَشْقَىٰهَا","(the) most wicked of them"]],"13":[["فَقَالَ","But said"],["لَهُمْ","to them"],["رَسُولُ","(the) Messenger"],["ٱللَّهِ","(of) Allah"],["نَاقَةَ","(It is the) she-camel"],["ٱللَّهِ","(of) Allah"],["وَسُقْيَـٰهَا","and her drink"]],"14":[["فَكَذَّبُوهُ","But they denied him"],["فَعَقَرُوهَا","and they hamstrung her"],["فَدَمْدَمَ","So destroyed"],["عَلَيْهِمْ","them"],["رَبُّهُم","their Lord"],["بِذَنۢبِهِمْ","for their sin"],["فَسَوَّىٰهَا","and leveled them"]],"15":[["وَلَا","And not"],["يَخَافُ","He fears"],["عُقْبَـٰهَا","its consequences"]]}