{"1":[["سَبِّحِ","Glorify"],["ٱسْمَ","(the) name"],["رَبِّكَ","(of) your Lord"],["ٱلْأَعْلَى","the Most High"]],"2":[["ٱلَّذِى","The One Who"],["خَلَقَ","created"],["فَسَوَّىٰ","then proportioned"]],"3":[["وَٱلَّذِى","And the One Who"],["قَدَّرَ","measured"],["فَهَدَىٰ","then guided"]],"4":[["وَٱلَّذِىٓ","And the One Who"],["أَخْرَجَ","brings forth"],["ٱلْمَرْعَىٰ","the pasture"]],"5":[["فَجَعَلَهُۥ","And then makes it"],["غُثَآءً","stubble"],["أَحْوَىٰ","dark"]],"6":[["سَنُقْرِئُكَ","We will make you recite"],["فَلَا","so not"],["تَنسَىٰٓ","you will forget"]],"7":[["إِلَّا","Except"],["مَا","what"],["شَآءَ","wills"],["ٱللَّهُ ۚ","Allah"],["إِنَّهُۥ","Indeed, He"],["يَعْلَمُ","knows"],["ٱلْجَهْرَ","the manifest"],["وَمَا","and what"],["يَخْفَىٰ","is hidden"]],"8":[["وَنُيَسِّرُكَ","And We will ease you"],["لِلْيُسْرَىٰ","to the ease"]],"9":[["فَذَكِّرْ","So remind"],["إِن","if"],["نَّفَعَتِ","benefits"],["ٱلذِّكْرَىٰ","the reminder"]],"10":[["سَيَذَّكَّرُ","He will pay heed"],["مَن","(one) who"],["يَخْشَىٰ","fears (Allah)"]],"11":[["وَيَتَجَنَّبُهَا","And will avoid it"],["ٱلْأَشْقَى","the wretched one"]],"12":[["ٱلَّذِى","The one who"],["يَصْلَى","will burn"],["ٱلنَّارَ","(in) the Fire"],["ٱلْكُبْرَىٰ","[the] great"]],"13":[["ثُمَّ","Then"],["لَا","not"],["يَمُوتُ","he will die"],["فِيهَا","therein"],["وَلَا","and not"],["يَحْيَىٰ","will live"]],"14":[["قَدْ","Certainly"],["أَفْلَحَ","has succeeded"],["مَن","(one) who"],["تَزَكَّىٰ","purifies (himself)"]],"15":[["وَذَكَرَ","And remembers"],["ٱسْمَ","(the) name"],["رَبِّهِۦ","(of) his Lord"],["فَصَلَّىٰ","and prays"]],"16":[["بَلْ","Nay"],["تُؤْثِرُونَ","You prefer"],["ٱلْحَيَوٰةَ","the life"],["ٱلدُّنْيَا","(of) the world"]],"17":[["وَٱلْـَٔاخِرَةُ","While the Hereafter"],["خَيْرٌۭ","(is) better"],["وَأَبْقَىٰٓ","and everlasting"]],"18":[["إِنَّ","Indeed"],["هَـٰذَا","this"],["لَفِى","surely (is) in"],["ٱلصُّحُفِ","the Scriptures"],["ٱلْأُولَىٰ","[the] former"]],"19":[["صُحُفِ","(The) Scriptures"],["إِبْرَٰهِيمَ","(of) Ibrahim"],["وَمُوسَىٰ","and Musa"]]}