{"1":[["وَٱلَّيْلِ","By the night"],["إِذَا","when"],["يَغْشَىٰ","it covers"]],"2":[["وَٱلنَّهَارِ","And the day"],["إِذَا","when"],["تَجَلَّىٰ","it shines in brightness"]],"3":[["وَمَا","And He Who"],["خَلَقَ","created"],["ٱلذَّكَرَ","the male"],["وَٱلْأُنثَىٰٓ","and the female"]],"4":[["إِنَّ","Indeed"],["سَعْيَكُمْ","your efforts"],["لَشَتَّىٰ","(are) surely diverse"]],"5":[["فَأَمَّا","Then as for"],["مَنْ","(him) who"],["أَعْطَىٰ","gives"],["وَٱتَّقَىٰ","and fears"]],"6":[["وَصَدَّقَ","And believes"],["بِٱلْحُسْنَىٰ","in the best"]],"7":[["فَسَنُيَسِّرُهُۥ","Then We will ease him"],["لِلْيُسْرَىٰ","towards [the] ease"]],"8":[["وَأَمَّا","But as for"],["مَنۢ","(him) who"],["بَخِلَ","withholds"],["وَٱسْتَغْنَىٰ","and considers himself free from need"]],"9":[["وَكَذَّبَ","And denies"],["بِٱلْحُسْنَىٰ","the best"]],"10":[["فَسَنُيَسِّرُهُۥ","Then We will ease him"],["لِلْعُسْرَىٰ","towards [the] difficulty"]],"11":[["وَمَا","And not"],["يُغْنِى","will avail"],["عَنْهُ","him"],["مَالُهُۥٓ","his wealth"],["إِذَا","when"],["تَرَدَّىٰٓ","he falls"]],"12":[["إِنَّ","Indeed"],["عَلَيْنَا","upon Us"],["لَلْهُدَىٰ","(is) the guidance"]],"13":[["وَإِنَّ","And indeed"],["لَنَا","for Us"],["لَلْـَٔاخِرَةَ","(is) the Hereafter"],["وَٱلْأُولَىٰ","and the first (life)"]],"14":[["فَأَنذَرْتُكُمْ","So I warn you"],["نَارًۭا","(of) a Fire"],["تَلَظَّىٰ","blazing"]],"15":[["لَا","Not"],["يَصْلَىٰهَآ","will burn (in) it"],["إِلَّا","except"],["ٱلْأَشْقَى","the most wretched"]],"16":[["ٱلَّذِى","The one who"],["كَذَّبَ","denied"],["وَتَوَلَّىٰ","and turned away"]],"17":[["وَسَيُجَنَّبُهَا","But will be removed from it"],["ٱلْأَتْقَى","the righteous"]],"18":[["ٱلَّذِى","The one who"],["يُؤْتِى","gives"],["مَالَهُۥ","his wealth"],["يَتَزَكَّىٰ","(to) purify himself"]],"19":[["وَمَا","And not"],["لِأَحَدٍ","for anyone"],["عِندَهُۥ","with him"],["مِن","any"],["نِّعْمَةٍۢ","favor"],["تُجْزَىٰٓ","to be recompensed"]],"20":[["إِلَّا","Except"],["ٱبْتِغَآءَ","seeking"],["وَجْهِ","(the) Countenance"],["رَبِّهِ","(of) his Lord"],["ٱلْأَعْلَىٰ","the Most High"]],"21":[["وَلَسَوْفَ","And soon, surely"],["يَرْضَىٰ","he will be pleased"]]}