{"1":[["أَرَءَيْتَ","Have you seen"],["ٱلَّذِى","the one who"],["يُكَذِّبُ","denies"],["بِٱلدِّينِ","the Judgment"]],"2":[["فَذَٰلِكَ","Then that"],["ٱلَّذِى","(is) the one who"],["يَدُعُّ","repulses"],["ٱلْيَتِيمَ","the orphan"]],"3":[["وَلَا","And (does) not"],["يَحُضُّ","feel the urge"],["عَلَىٰ","to"],["طَعَامِ","feed"],["ٱلْمِسْكِينِ","the poor"]],"4":[["فَوَيْلٌۭ","So woe"],["لِّلْمُصَلِّينَ","to those who pray"]],"5":[["ٱلَّذِينَ","Those who"],["هُمْ","[they]"],["عَن","about"],["صَلَاتِهِمْ","their prayers"],["سَاهُونَ","(are) neglectful"]],"6":[["ٱلَّذِينَ","Those who"],["هُمْ","[they]"],["يُرَآءُونَ","make show"]],"7":[["وَيَمْنَعُونَ","And they deny"],["ٱلْمَاعُونَ","[the] small kindnesses"]]}