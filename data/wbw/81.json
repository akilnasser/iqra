{"1":[["إِذَا","When"],["ٱلشَّمْسُ","the sun"],["كُوِّرَتْ","is wrapped up"]],"2":[["وَإِذَا","And when"],["ٱلنُّجُومُ","the stars"],["ٱنكَدَرَتْ","fall, losing their luster"]],"3":[["وَإِذَا","And when"],["ٱلْجِبَالُ","the mountains"],["سُيِّرَتْ","are moved away"]],"4":[["وَإِذَا","And when"],["ٱلْعِشَارُ","the full-term she-camels"],["عُطِّلَتْ","(are) left untended"]],"5":[["وَإِذَا","And when"],["ٱلْوُحُوشُ","the wild beasts"],["حُشِرَتْ","are gathered"]],"6":[["وَإِذَا","And when"],["ٱلْبِحَارُ","the seas"],["سُجِّرَتْ","are made to overflow"]],"7":[["وَإِذَا","And when"],["ٱلنُّفُوسُ","the souls"],["زُوِّجَتْ","are paired"]],"8":[["وَإِذَا","And when"],["ٱلْمَوْءُۥدَةُ","the female infant buried alive"],["سُئِلَتْ","is asked"]],"9":[["بِأَىِّ","For what"],["ذَنۢبٍۢ","sin"],["قُتِلَتْ","she was killed"]],"10":[["وَإِذَا","And when"],["ٱلصُّحُفُ","the pages"],["نُشِرَتْ","are laid open"]],"11":[["وَإِذَا","And when"],["ٱلسَّمَآءُ","the sky"],["كُشِطَتْ","is stripped away"]],"12":[["وَإِذَا","And when"],["ٱلْجَحِيمُ","the Hellfire"],["سُعِّرَتْ","is set ablaze"]],"13":[["وَإِذَا","And when"],["ٱلْجَنَّةُ","Paradise"],["أُزْلِفَتْ","is brought near"]],"14":[["عَلِمَتْ","Will know"],["نَفْسٌۭ","a soul"],["مَّآ","what"],["أَحْضَرَتْ","it has brought"]],"15":[["فَلَآ","But nay"],["أُقْسِمُ","I swear"],["بِٱلْخُنَّسِ","by the retreating planets"]],"16":[["ٱلْجَوَارِ","Those that run"],["ٱلْكُنَّسِ","(and) disappear"]],"17":[["وَٱلَّيْلِ","And the night"],["إِذَا","when"],["عَسْعَسَ","it departs"]],"18":[["وَٱلصُّبْحِ","And the dawn"],["إِذَا","when"],["تَنَفَّسَ","it breathes"]],"19":[["إِنَّهُۥ","Indeed, it"],["لَقَوْلُ","(is) surely a word"],["رَسُولٍۢ","(of) a Messenger"],["كَرِيمٍۢ","noble"]],"20":[["ذِى","Possessor of"],["قُوَّةٍ","power"],["عِندَ","with"],["ذِى","(the) Owner of"],["ٱلْعَرْشِ","the Throne"],["مَكِينٍۢ","secure"]],"21":[["مُّطَاعٍۢ","One to be obeyed"],["ثَمَّ","and"],["أَمِينٍۢ","trustworthy"]],"22":[["وَمَا","And not"],["صَاحِبُكُم","(is) your companion"],["بِمَجْنُونٍۢ","mad"]],"23":[["وَلَقَدْ","And certainly"],["رَءَاهُ","he saw him"],["بِٱلْأُفُقِ","in the horizon"],["ٱلْمُبِينِ","the clear"]],"24":[["وَمَا","And not"],["هُوَ","he (is)"],["عَلَى","on"],["ٱلْغَيْبِ","the unseen"],["بِضَنِينٍۢ","a withholder"]],"25":[["وَمَا","And not"],["هُوَ","it"],["بِقَوْلِ","(is the) word"],["شَيْطَـٰنٍۢ","(of) Shaitaan"],["رَّجِيمٍۢ","accursed"]],"26":[["فَأَيْنَ","So where"],["تَذْهَبُونَ","are you going"]],"27":[["إِنْ","Not"],["هُوَ","it"],["إِلَّا","(is) except"],["ذِكْرٌۭ","a reminder"],["لِّلْعَـٰلَمِينَ","to the worlds"]],"28":[["لِمَن","For whoever"],["شَآءَ","wills"],["مِنكُمْ","among you"],["أَن","to"],["يَسْتَقِيمَ","take a straight way"]],"29":[["وَمَا","And not"],["تَشَآءُونَ","you will"],["إِلَّآ","except"],["أَن","that"],["يَشَآءَ","wills"],["ٱللَّهُ","Allah"],["رَبُّ","Lord"],["ٱلْعَـٰلَمِينَ","(of) the worlds"]]}