{"1":[["هَلْ","Has"],["أَتَىٰكَ","(there) come to you"],["حَدِيثُ","(the) news"],["ٱلْغَـٰشِيَةِ","(of) the Overwhelming"]],"2":[["وُجُوهٌۭ","Faces"],["يَوْمَئِذٍ","that Day"],["خَـٰشِعَةٌ","(will be) humbled"]],"3":[["عَامِلَةٌۭ","Laboring"],["نَّاصِبَةٌۭ","exhausted"]],"4":[["تَصْلَىٰ","They will burn"],["نَارًا","(in) a Fire"],["حَامِيَةًۭ","intensely hot"]],"5":[["تُسْقَىٰ","They will be given to drink"],["مِنْ","from"],["عَيْنٍ","a spring"],["ءَانِيَةٍۢ","boiling"]],"6":[["لَّيْسَ","Not is"],["لَهُمْ","for them"],["طَعَامٌ","food"],["إِلَّا","except"],["مِن","from"],["ضَرِيعٍۢ","a bitter thorny plant"]],"7":[["لَّا","Not"],["يُسْمِنُ","it nourishes"],["وَلَا","and not"],["يُغْنِى","it avails"],["مِن","from"],["جُوعٍۢ","hunger"]],"8":[["وُجُوهٌۭ","Faces"],["يَوْمَئِذٍۢ","that Day"],["نَّاعِمَةٌۭ","(will be) joyful"]],"9":[["لِّسَعْيِهَا","With their effort"],["رَاضِيَةٌۭ","satisfied"]],"10":[["فِى","In"],["جَنَّةٍ","a garden"],["عَالِيَةٍۢ","elevated"]],"11":[["لَّا","Not"],["تَسْمَعُ","they will hear"],["فِيهَا","therein"],["لَـٰغِيَةًۭ","vain talk"]],"12":[["فِيهَا","Therein"],["عَيْنٌۭ","(will be) a spring"],["جَارِيَةٌۭ","flowing"]],"13":[["فِيهَا","Therein"],["سُرُرٌۭ","(will be) thrones"],["مَّرْفُوعَةٌۭ","raised high"]],"14":[["وَأَكْوَابٌۭ","And cups"],["مَّوْضُوعَةٌۭ","put in place"]],"15":[["وَنَمَارِقُ","And cushions"],["مَصْفُوفَةٌۭ","lined up"]],"16":[["وَزَرَابِىُّ","And carpets"],["مَبْثُوثَةٌ","spread out"]],"17":[["أَفَلَا","Then do not"],["يَنظُرُونَ","they look"],["إِلَى","towards"],["ٱلْإِبِلِ","the camels"],["كَيْفَ","how"],["خُلِقَتْ","they are created"]],"18":[["وَإِلَى","And towards"],["ٱلسَّمَآءِ","the sky"],["كَيْفَ","how"],["رُفِعَتْ","it is raised"]],"19":[["وَإِلَى","And towards"],["ٱلْجِبَالِ","the mountains"],["كَيْفَ","how"],["نُصِبَتْ","they are fixed"]],"20":[["وَإِلَى","And towards"],["ٱلْأَرْضِ","the earth"],["كَيْفَ","how"],["سُطِحَتْ","it is spread out"]],"21":[["فَذَكِّرْ","So remind"],["إِنَّمَآ","only"],["أَنتَ","you"],["مُذَكِّرٌۭ","(are) a reminder"]],"22":[["لَّسْتَ","You are not"],["عَلَيْهِم","over them"],["بِمُصَيْطِرٍ","a controller"]],"23":[["إِلَّا","But"],["مَن","whoever"],["تَوَلَّىٰ","turns away"],["وَكَفَرَ","and disbelieves"]],"24":[["فَيُعَذِّبُهُ","Then will punish him"],["ٱللَّهُ","Allah"],["ٱلْعَذَابَ","(with) the punishment"],["ٱلْأَكْبَرَ","greatest"]],"25":[["إِنَّ","Indeed"],["إِلَيْنَآ","to Us"],["إِيَابَهُمْ","(will be) their return"]],"26":[["ثُمَّ","Then"],["إِنَّ","indeed"],["عَلَيْنَا","upon Us"],["حِسَابَهُم","(is) their account"]]}