{"1":[["ٱقْرَأْ","Read"],["بِٱسْمِ","in (the) name"],["رَبِّكَ","(of) your Lord"],["ٱلَّذِى","the One Who"],["خَلَقَ","created"]],"2":[["خَلَقَ","He created"],["ٱلْإِنسَـٰنَ","man"],["مِنْ","from"],["عَلَقٍ","a clinging substance"]],"3":[["ٱقْرَأْ","Read"],["وَرَبُّكَ","and your Lord"],["ٱلْأَكْرَمُ","(is) the Most Generous"]],"4":[["ٱلَّذِى","The One Who"],["عَلَّمَ","taught"],["بِٱلْقَلَمِ","by the pen"]],"5":[["عَلَّمَ","Taught"],["ٱلْإِنسَـٰنَ","man"],["مَا","what"],["لَمْ","not"],["يَعْلَمْ","he knew"]],"6":[["كَلَّآ","Nay"],["إِنَّ","Indeed"],["ٱلْإِنسَـٰنَ","man"],["لَيَطْغَىٰٓ","surely transgresses"]],"7":[["أَن","That"],["رَّءَاهُ","he sees himself"],["ٱسْتَغْنَىٰٓ","self-sufficient"]],"8":[["إِنَّ","Indeed"],["إِلَىٰ","to"],["رَبِّكَ","your Lord"],["ٱلرُّجْعَىٰٓ","(is) the return"]],"9":[["أَرَءَيْتَ","Have you seen"],["ٱلَّذِى","the one who"],["يَنْهَىٰ","forbids"]],"10":[["عَبْدًا","A slave"],["إِذَا","when"],["صَلَّىٰٓ","he prays"]],"11":[["أَرَءَيْتَ","Have you seen"],["إِن","if"],["كَانَ","he is"],["عَلَى","upon"],["ٱلْهُدَىٰٓ","[the] guidance"]],"12":[["أَوْ","Or"],["أَمَرَ","he enjoins"],["بِٱلتَّقْوَىٰٓ","[of the] righteousness"]],"13":[["أَرَءَيْتَ","Have you seen"],["إِن","if"],["كَذَّبَ","he denies"],["وَتَوَلَّىٰٓ","and turns away"]],"14":[["أَلَمْ","Does not"],["يَعْلَم","he know"],["بِأَنَّ","that"],["ٱللَّهَ","Allah"],["يَرَىٰ","sees"]],"15":[["كَلَّا","Nay"],["لَئِن","If"],["لَّمْ","not"],["يَنتَهِ","he desists"],["لَنَسْفَعًۢا","surely We will drag him"],["بِٱلنَّاصِيَةِ","by the forelock"]],"16":[["نَاصِيَةٍۢ","A forelock"],["كَـٰذِبَةٍ","lying"],["خَاطِئَةٍۢ","sinful"]],"17":[["فَلْيَدْعُ","Then let him call"],["نَادِيَهُۥ","his associates"]],"18":[["سَنَدْعُ","We will call"],["ٱلزَّبَانِيَةَ","the Angels of Hell"]],"19":[["كَلَّا","Nay"],["لَا","(Do) not"],["تُطِعْهُ","obey him"],["وَٱسْجُدْ","But prostrate"],["وَٱقْتَرِب ۩","and draw near (to Allah)"]]}