{"1":[["عَبَسَ","He frowned"],["وَتَوَلَّىٰٓ","and turned away"]],"2":[["أَن","Because"],["جَآءَهُ","came to him"],["ٱلْأَعْمَىٰ","the blind man"]],"3":[["وَمَا","But what"],["يُدْرِيكَ","would make you know"],["لَعَلَّهُۥ","that he might"],["يَزَّكَّىٰٓ","purify himself"]],"4":[["أَوْ","Or"],["يَذَّكَّرُ","be reminded"],["فَتَنفَعَهُ","so would benefit him"],["ٱلذِّكْرَىٰٓ","the reminder"]],"5":[["أَمَّا","As for"],["مَنِ","(him) who"],["ٱسْتَغْنَىٰ","considers himself free from need"]],"6":[["فَأَنتَ","So you"],["لَهُۥ","to him"],["تَصَدَّىٰ","give attention"]],"7":[["وَمَا","And not"],["عَلَيْكَ","upon you"],["أَلَّا","that not"],["يَزَّكَّىٰ","he purifies himself"]],"8":[["وَأَمَّا","But as for"],["مَن","(he) who"],["جَآءَكَ","came to you"],["يَسْعَىٰ","striving"]],"9":[["وَهُوَ","While he"],["يَخْشَىٰ","fears"]],"10":[["فَأَنتَ","But you"],["عَنْهُ","from him"],["تَلَهَّىٰ","(are) distracted"]],"11":[["كَلَّآ","Nay"],["إِنَّهَا","Indeed, it"],["تَذْكِرَةٌۭ","(is) a reminder"]],"12":[["فَمَن","So whosoever"],["شَآءَ","wills"],["ذَكَرَهُۥ","may remember it"]],"13":[["فِى","In"],["صُحُفٍۢ","sheets"],["مُّكَرَّمَةٍۢ","honored"]],"14":[["مَّرْفُوعَةٍۢ","Exalted"],["مُّطَهَّرَةٍۭ","purified"]],"15":[["بِأَيْدِى","In (the) hands"],["سَفَرَةٍۢ","(of) scribes"]],"16":[["كِرَامٍۭ","Noble"],["بَرَرَةٍۢ","dutiful"]],"17":[["قُتِلَ","Is destroyed"],["ٱلْإِنسَـٰنُ","[the] man"],["مَآ","how"],["أَكْفَرَهُۥ","ungrateful is he"]],"18":[["مِنْ","From"],["أَىِّ","what"],["شَىْءٍ","thing"],["خَلَقَهُۥ","He created him"]],"19":[["مِن","From"],["نُّطْفَةٍ","a semen-drop"],["خَلَقَهُۥ","He created him"],["فَقَدَّرَهُۥ","then He proportioned him"]],"20":[["ثُمَّ","Then"],["ٱلسَّبِيلَ","the way"],["يَسَّرَهُۥ","He made easy for him"]],"21":[["ثُمَّ","Then"],["أَمَاتَهُۥ","He causes him to die"],["فَأَقْبَرَهُۥ","and provides a grave for him"]],"22":[["ثُمَّ","Then"],["إِذَا","when"],["شَآءَ","He wills"],["أَنشَرَهُۥ","He will resurrect him"]],"23":[["كَلَّا","Nay"],["لَمَّا","Not"],["يَقْضِ","he has accomplished"],["مَآ","what"],["أَمَرَهُۥ","He commanded him"]],"24":[["فَلْيَنظُرِ","Then let look"],["ٱلْإِنسَـٰنُ","the man"],["إِلَىٰ","at"],["طَعَامِهِۦٓ","his food"]],"25":[["اَنَّا","That [We]"],["صَبَبْنَا","[We] poured"],["ٱلْمَآءَ","the water"],["صَبًّۭا","(in) abundance"]],"26":[["ثُمَّ","Then"],["شَقَقْنَا","We cleaved"],["ٱلْأَرْضَ","the earth"],["شَقًّۭا","splitting"]],"27":[["فَأَنۢبَتْنَا","Then We caused to grow"],["فِيهَا","therein"],["حَبًّۭا","grain"]],"28":[["وَعِنَبًۭا","And grapes"],["وَقَضْبًۭا","and green fodder"]],"29":[["وَزَيْتُونًۭا","And olive"],["وَنَخْلًۭا","and date-palms"]],"30":[["وَحَدَآئِقَ","And gardens"],["غُلْبًۭا","(of) thick foliage"]],"31":[["وَفَـٰكِهَةًۭ","And fruits"],["وَأَبًّۭا","and grass"]],"32":[["مَّتَـٰعًۭا","(As) a provision"],["لَّكُمْ","for you"],["وَلِأَنْعَـٰمِكُمْ","and for your cattle"]],"33":[["فَإِذَا","But when"],["جَآءَتِ","comes"],["ٱلصَّآخَّةُ","the Deafening Blast"]],"34":[["يَوْمَ","(The) Day"],["يَفِرُّ","will flee"],["ٱلْمَرْءُ","a man"],["مِنْ","from"],["أَخِيهِ","his brother"]],"35":[["وَأُمِّهِۦ","And his mother"],["وَأَبِيهِ","and his father"]],"36":[["وَصَـٰحِبَتِهِۦ","And his wife"],["وَبَنِيهِ","and his children"]],"37":[["لِكُلِّ","For every"],["ٱمْرِئٍۢ","man"],["مِّنْهُمْ","among them"],["يَوْمَئِذٍۢ","that Day"],["شَأْنٌۭ","(will be) a matter"],["يُغْنِيهِ","occupying him"]],"38":[["وُجُوهٌۭ","Faces"],["يَوْمَئِذٍۢ","that Day"],["مُّسْفِرَةٌۭ","(will be) bright"]],"39":[["ضَاحِكَةٌۭ","Laughing"],["مُّسْتَبْشِرَةٌۭ","rejoicing at good news"]],"40":[["وَوُجُوهٌۭ","And faces"],["يَوْمَئِذٍ","that Day"],["عَلَيْهَا","upon them"],["غَبَرَةٌۭ","(will be) dust"]],"41":[["تَرْهَقُهَا","Will cover them"],["قَتَرَةٌ","darkness"]],"42":[["أُو۟لَـٰٓئِكَ","Those"],["هُمُ","[they]"],["ٱلْكَفَرَةُ","(are) the disbelievers"],["ٱلْفَجَرَةُ","the wicked ones"]]}