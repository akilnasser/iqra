{"1":[["إِذَا","When"],["ٱلسَّمَآءُ","the sky"],["ٱنشَقَّتْ","is split asunder"]],"2":[["وَأَذِنَتْ","And has listened"],["لِرَبِّهَا","to its Lord"],["وَحُقَّتْ","and was obligated"]],"3":[["وَإِذَا","And when"],["ٱلْأَرْضُ","the earth"],["مُدَّتْ","is spread"]],"4":[["وَأَلْقَتْ","And has cast out"],["مَا","what"],["فِيهَا","(is) in it"],["وَتَخَلَّتْ","and becomes empty"]],"5":[["وَأَذِنَتْ","And has listened"],["لِرَبِّهَا","to its Lord"],["وَحُقَّتْ","and was obligated"]],"6":[["يَـٰٓأَيُّهَا","O"],["ٱلْإِنسَـٰنُ","mankind"],["إِنَّكَ","Indeed, you"],["كَادِحٌ","(are) laboring"],["إِلَىٰ","to"],["رَبِّكَ","your Lord"],["كَدْحًۭا","(with) exertion"],["فَمُلَـٰقِيهِ","and you (will) meet Him"]],"7":[["فَأَمَّا","Then as for"],["مَنْ","(him) who"],["أُوتِىَ","is given"],["كِتَـٰبَهُۥ","his record"],["بِيَمِينِهِۦ","in his right (hand)"]],"8":[["فَسَوْفَ","Then soon"],["يُحَاسَبُ","his account will be taken"],["حِسَابًۭا","an account"],["يَسِيرًۭا","easy"]],"9":[["وَيَنقَلِبُ","And he will return"],["إِلَىٰٓ","to"],["أَهْلِهِۦ","his people"],["مَسْرُورًۭا","happily"]],"10":[["وَأَمَّا","But as for"],["مَنْ","(him) who"],["أُوتِىَ","is given"],["كِتَـٰبَهُۥ","his record"],["وَرَآءَ","behind"],["ظَهْرِهِۦ","his back"]],"11":[["فَسَوْفَ","Then soon"],["يَدْعُوا۟","he will call"],["ثُبُورًۭا","(for) destruction"]],"12":[["وَيَصْلَىٰ","And he will burn"],["سَعِيرًا","(in) a Blaze"]],"13":[["إِنَّهُۥ","Indeed, he"],["كَانَ","had been"],["فِىٓ","among"],["أَهْلِهِۦ","his people"],["مَسْرُورًا","happy"]],"14":[["إِنَّهُۥ","Indeed, he"],["ظَنَّ","(had) thought"],["أَن","that"],["لَّن","never"],["يَحُورَ","he would return"]],"15":[["بَلَىٰٓ","Yes"],["إِنَّ","Indeed"],["رَبَّهُۥ","his Lord"],["كَانَ","was"],["بِهِۦ","of him"],["بَصِيرًۭا","All-Seer"]],"16":[["فَلَآ","But nay"],["أُقْسِمُ","I swear"],["بِٱلشَّفَقِ","by the twilight glow"]],"17":[["وَٱلَّيْلِ","And the night"],["وَمَا","and what"],["وَسَقَ","it envelops"]],"18":[["وَٱلْقَمَرِ","And the moon"],["إِذَا","when"],["ٱتَّسَقَ","it becomes full"]],"19":[["لَتَرْكَبُنَّ","You will surely embark"],["طَبَقًا","(to) stage"],["عَن","from"],["طَبَقٍۢ","stage"]],"20":[["فَمَا","So what"],["لَهُمْ","(is) for them"],["لَا","not"],["يُؤْمِنُونَ","they believe"]],"21":[["وَإِذَا","And when"],["قُرِئَ","is recited"],["عَلَيْهِمُ","to them"],["ٱلْقُرْءَانُ","the Quran"],["لَا","not"],["يَسْجُدُونَ ۩","they prostrate"]],"22":[["بَلِ","Nay"],["ٱلَّذِينَ","Those who"],["كَفَرُوا۟","disbelieved"],["يُكَذِّبُونَ","deny"]],"23":[["وَٱللَّهُ","And Allah"],["أَعْلَمُ","(is) most knowing"],["بِمَا","of what"],["يُوعُونَ","they keep within themselves"]],"24":[["فَبَشِّرْهُم","so give them tidings"],["بِعَذَابٍ","of a punishment"],["أَلِيمٍ","painful"]],"25":[["إِلَّا","Except"],["ٱلَّذِينَ","those who"],["ءَامَنُوا۟","believe"],["وَعَمِلُوا۟","and do"],["ٱلصَّـٰلِحَـٰتِ","righteous deeds"],["لَهُمْ","For them"],["أَجْرٌ","(is) a reward"],["غَيْرُ","never"],["مَمْنُونٍۭ","ending"]]}