{"1":[["وَٱلضُّحَىٰ","By the morning brightness"]],"2":[["وَٱلَّيْلِ","And the night"],["إِذَا","when"],["سَجَىٰ","it covers with darkness"]],"3":[["مَا","Not"],["وَدَّعَكَ","has forsaken you"],["رَبُّكَ","your Lord"],["وَمَا","and not"],["قَلَىٰ","He is displeased"]],"4":[["وَلَلْـَٔاخِرَةُ","And surely the Hereafter"],["خَيْرٌۭ","(is) better"],["لَّكَ","for you"],["مِنَ","than"],["ٱلْأُولَىٰ","the first"]],"5":[["وَلَسَوْفَ","And soon"],["يُعْطِيكَ","will give you"],["رَبُّكَ","your Lord"],["فَتَرْضَىٰٓ","then you will be satisfied"]],"6":[["أَلَمْ","Did not"],["يَجِدْكَ","He find you"],["يَتِيمًۭا","an orphan"],["فَـَٔاوَىٰ","and give shelter"]],"7":[["وَوَجَدَكَ","And He found you"],["ضَآلًّۭا","lost"],["فَهَدَىٰ","so He guided"]],"8":[["وَوَجَدَكَ","And He found you"],["عَآئِلًۭا","in need"],["فَأَغْنَىٰ","so He made self-sufficient"]],"9":[["فَأَمَّا","So as for"],["ٱلْيَتِيمَ","the orphan"],["فَلَا","then (do) not"],["تَقْهَرْ","oppress"]],"10":[["وَأَمَّا","And as for"],["ٱلسَّآئِلَ","one who asks"],["فَلَا","then (do) not"],["تَنْهَرْ","repel"]],"11":[["وَأَمَّا","But as for"],["بِنِعْمَةِ","(the) Favor"],["رَبِّكَ","(of) your Lord"],["فَحَدِّثْ","narrate"]]}