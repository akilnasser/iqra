{"1":[["وَٱلْعَـٰدِيَـٰتِ","By the racers"],["ضَبْحًۭا","panting"]],"2":[["فَٱلْمُورِيَـٰتِ","And the producers of sparks"],["قَدْحًۭا","striking"]],"3":[["فَٱلْمُغِيرَٰتِ","And the chargers"],["صُبْحًۭا","(at) dawn"]],"4":[["فَأَثَرْنَ","Then raise"],["بِهِۦ","thereby"],["نَقْعًۭا","dust"]],"5":[["فَوَسَطْنَ","Then penetrate (in the) center"],["بِهِۦ","thereby"],["جَمْعًا","collectively"]],"6":[["إِنَّ","Indeed"],["ٱلْإِنسَـٰنَ","mankind"],["لِرَبِّهِۦ","to his Lord"],["لَكَنُودٌۭ","(is) surely ungrateful"]],"7":[["وَإِنَّهُۥ","And indeed, he"],["عَلَىٰ","on"],["ذَٰلِكَ","that"],["لَشَهِيدٌۭ","surely (is) a witness"]],"8":[["وَإِنَّهُۥ","And indeed he"],["لِحُبِّ","in (the) love"],["ٱلْخَيْرِ","(of) wealth"],["لَشَدِيدٌ","(is) surely intense"]],"9":[["۞ أَفَلَا","But does not"],["يَعْلَمُ","he know"],["إِذَا","when"],["بُعْثِرَ","will be scattered"],["مَا","what"],["فِى","(is) in"],["ٱلْقُبُورِ","the graves"]],"10":[["وَحُصِّلَ","And is made apparent"],["مَا","what"],["فِى","(is) in"],["ٱلصُّدُورِ","the breasts"]],"11":[["إِنَّ","Indeed"],["رَبَّهُم","their Lord"],["بِهِمْ","about them"],["يَوْمَئِذٍۢ","that Day"],["لَّخَبِيرٌۢ","(is) surely All-Aware"]]}