{"1":[["إِذَا","When"],["ٱلسَّمَآءُ","the sky"],["ٱنفَطَرَتْ","(is) cleft asunder"]],"2":[["وَإِذَا","And when"],["ٱلْكَوَاكِبُ","the stars"],["ٱنتَثَرَتْ","scatter"]],"3":[["وَإِذَا","And when"],["ٱلْبِحَارُ","the seas"],["فُجِّرَتْ","are made to gush forth"]],"4":[["وَإِذَا","And when"],["ٱلْقُبُورُ","the graves"],["بُعْثِرَتْ","are overturned"]],"5":[["عَلِمَتْ","Will know"],["نَفْسٌۭ","a soul"],["مَّا","what"],["قَدَّمَتْ","it has sent forth"],["وَأَخَّرَتْ","and left behind"]],"6":[["يَـٰٓأَيُّهَا","O"],["ٱلْإِنسَـٰنُ","man"],["مَا","What"],["غَرَّكَ","has deceived you"],["بِرَبِّكَ","concerning your Lord"],["ٱلْكَرِيمِ","the Most Noble"]],"7":[["ٱلَّذِى","Who"],["خَلَقَكَ","created you"],["فَسَوَّىٰكَ","then fashioned you"],["فَعَدَلَكَ","then balanced you"]],"8":[["فِىٓ","In"],["أَىِّ","whatever"],["صُورَةٍۢ","form"],["مَّا","what"],["شَآءَ","He willed"],["رَكَّبَكَ","He assembled you"]],"9":[["كَلَّا","Nay"],["بَلْ","But"],["تُكَذِّبُونَ","you deny"],["بِٱلدِّينِ","the Judgment"]],"10":[["وَإِنَّ","And indeed"],["عَلَيْكُمْ","over you"],["لَحَـٰفِظِينَ","(are) surely guardians"]],"11":[["كِرَامًۭا","Noble"],["كَـٰتِبِينَ","recording"]],"12":[["يَعْلَمُونَ","They know"],["مَا","whatever"],["تَفْعَلُونَ","you do"]],"13":[["إِنَّ","Indeed"],["ٱلْأَبْرَارَ","the righteous"],["لَفِى","(will be) surely in"],["نَعِيمٍۢ","bliss"]],"14":[["وَإِنَّ","And indeed"],["ٱلْفُجَّارَ","the wicked"],["لَفِى","(will be) surely in"],["جَحِيمٍۢ","Hellfire"]],"15":[["يَصْلَوْنَهَا","They will burn (in) it"],["يَوْمَ","(on the) Day"],["ٱلدِّينِ","(of) the Judgment"]],"16":[["وَمَا","And not"],["هُمْ","they"],["عَنْهَا","from it"],["بِغَآئِبِينَ","(will be) absent"]],"17":[["وَمَآ","And what"],["أَدْرَىٰكَ","can make you know"],["مَا","what"],["يَوْمُ","(is the) Day"],["ٱلدِّينِ","(of) the Judgment"]],"18":[["ثُمَّ","Then"],["مَآ","what"],["أَدْرَىٰكَ","can make you know"],["مَا","what"],["يَوْمُ","(is the) Day"],["ٱلدِّينِ","(of) the Judgment"]],"19":[["يَوْمَ","(The) Day"],["لَا","not"],["تَمْلِكُ","will have power"],["نَفْسٌۭ","a soul"],["لِّنَفْسٍۢ","for a soul"],["شَيْـًۭٔا ۖ","anything"],["وَٱلْأَمْرُ","and the Command"],["يَوْمَئِذٍۢ","that Day"],["لِّلَّهِ","(will be) with Allah"]]}